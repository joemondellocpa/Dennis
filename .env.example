# ============================================================
# Dennis Agent - Environment Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- DeepSeek ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat          # or deepseek-reasoner for complex tasks

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here   # From @BotFather
TELEGRAM_ALLOWED_USERS=your_telegram_user_id_here # Comma-separated numeric IDs

# --- GitHub ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# --- Google OAuth ---
# Download credentials.json from Google Cloud Console
# Project > APIs & Services > Credentials > OAuth 2.0 Client ID (Desktop app)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# --- LinkedIn (Playwright automation) ---
LINKEDIN_EMAIL=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here
LINKEDIN_COOKIES_FILE=data/linkedin_cookies.json

# --- Agent Behavior ---
AGENT_NAME=Dennis
AGENT_TIMEZONE=America/New_York       # Your local timezone
AUTONOMOUS_LOOP_INTERVAL=300          # Seconds between background goal checks (300 = 5 min)
MAX_TOOL_CALLS_PER_TURN=10            # Safety limit on tool calls per conversation turn
MEMORY_MAX_RESULTS=10                 # How many memory chunks to retrieve per query

# --- Data Paths ---
DATA_DIR=data
MEMORY_DB_PATH=data/memory.db
CHROMA_DB_PATH=data/chroma_db
GOALS_DB_PATH=data/goals.db
LOGS_PATH=data/logs

# --- Additional Model Providers (all disabled by default) ---
# Enable one at a time. Always validate before enabling in production:
#   python scripts/test_models.py

# Groq – ~500 tok/s, OpenAI-compatible. Best for low-latency interactive tasks.
# API key: https://console.groq.com/
GROQ_ENABLED=false
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Flash – 1M token context, OpenAI-compatible. Best for long documents.
# API key: https://aistudio.google.com/apikey
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Claude – Anthropic SDK (not OpenAI-compatible). Best writing quality.
# Setup: pip install anthropic
# API key: https://console.anthropic.com/
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
